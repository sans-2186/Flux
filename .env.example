# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Fast default for Phase 1 voice answers (use gemini-3.8-flash only if you need higher quality).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=280
