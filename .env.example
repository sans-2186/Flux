# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Primary model, then fallbacks if busy (503) or slow.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1024
# Text-to-speech for POST /speak (if both fail, /speak tells the frontend to use browser speech)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL_FALLBACKS=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Public path prefix the backend also answers on (Vercel forwards /api/flux/* to this service).
FLUX_API_PREFIX=/api/flux
# Where onboarded users are mirrored. Defaults to /tmp/flux-users.json on Vercel (read-only FS).
# FLUX_DATA_FILE=data/users.json
