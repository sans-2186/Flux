{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "ui": {
      "root": "ui",
      "framework": "nextjs",
      "buildCommand": "node scripts/vercel-prepare.mjs && next build",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "FLUX_APP_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/flux/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ui"
      }
    }
  ]
}
