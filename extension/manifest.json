{
  "manifest_version": 3,
  "name": "Flux Financial Companion",
  "version": "1.1.0",
  "description": "Popup money coach on Toyota vehicle pages using your Flux onboarding numbers.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://myflux.us/*",
    "https://*.myflux.us/*",
    "https://toyota.com/*",
    "https://*.toyota.com/*",
    "https://*.toyotaofplano.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://toyota.com/*",
        "https://*.toyota.com/*",
        "https://*.toyotaofplano.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
